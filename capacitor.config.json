{
  "appId": "com.civicai.app",
  "appName": "CivicAI",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    },
    "Geolocation": {
      "enableHighAccuracy": true
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}
